# @defaultSensitive=false
# @defaultRequired=infer

# Chosen manually after cloning. Keep this value private.
# @required @sensitive
GLANCE_AUTH_USERNAME=

# Raw password used only by scripts/generate-secrets.sh; never provide it to Compose or GitHub.
# @required @sensitive
GLANCE_AUTH_PASSWORD=

# Generate once with: docker run --rm glanceapp/glance:v0.8.8 secret:make
# @required @sensitive
GLANCE_AUTH_SECRET_KEY=

# Generated by scripts/generate-secrets.sh, then stored locally and as a GitHub Environment secret.
# @sensitive
GLANCE_AUTH_PASSWORD_HASH=

# Required only for production Compose.
# @sensitive
CLOUDFLARE_TUNNEL_TOKEN=
